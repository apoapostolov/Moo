{
  "manifest_version": 3,
  "name": "Moo",
  "description": "Fast, open and free-to-use new tab page for Firefox.",
  "version": "7.6.0",
  "homepage_url": "https://github.com/apoapostolov/Moo",
  "action": {
    "default_icon": "icons/128x128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/16x16.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "moo@apoapostolov"
    }
  }
}
